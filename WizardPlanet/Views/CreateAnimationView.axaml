<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WizardPlanet.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WizardPlanet.Views.CreateAnimationView"
             x:DataType="vm:CreateAnimationViewModel">
    
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
          ColumnDefinitions="Auto,*"
          Margin="20">
        
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Input Rectangular Projection Map:" 
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <TextBox Text="{Binding InputMapPath}" Width="400" IsReadOnly="True" />
            <Button Content="Browse..." Command="{Binding BrowseCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Animation Name:" 
                   VerticalAlignment="Center" Margin="0,10,10,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AnimationName}" 
                 Margin="0,10,0,0" />
        
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Description:" 
                   VerticalAlignment="Top" Margin="0,10,10,0" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AnimationDescription}" 
                 AcceptsReturn="True" TextWrapping="Wrap"
                 Height="100" Margin="0,10,0,0" />

        <Button Grid.Row="4" Grid.Column="1" Content="Create Animation" 
                Command="{Binding CreateAnimationCommand}" 
                HorizontalAlignment="Right" Margin="0,20,0,0" />
        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Grid.Column="0" TextAlignment="Center" Text="{Binding StatusMessage}"/>
    </Grid>
</UserControl>