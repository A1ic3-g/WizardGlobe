<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WizardPlanet.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:WizardPlanet.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WizardPlanet.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="WizardPlanet"
        x:DataType="viewModels:MainWindowViewModel">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- Add a top bar with a Back button -->
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeBackgroundBrush}" Padding="8">
            <Button Content="Back"
                    Command="{Binding NavigateBackCommand}"
                    HorizontalAlignment="Left" />
        </Border>

        <!-- Main content -->
        <ContentControl Content="{Binding ContentViewModel}" />
    </DockPanel>
</Window>