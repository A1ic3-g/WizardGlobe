<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WizardPlanet.ViewModels"
        x:Class="WizardPlanet.Views.PlaybackWindow"
        x:DataType="vm:PlayAnimationViewModel"
        Width="800" Height="600"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="Black">
    <Grid Background="Black" ClipToBounds="False">
        <Image Source="{Binding CurrentBitmap}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="Uniform"
               Height="{Binding Bounds.Height, RelativeSource={RelativeSource AncestorType=Window}}">
            <Image.RenderTransform>
                <RotateTransform Angle="{Binding AngleDegrees}" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>